<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="../../static/styles/main.css">
    <link rel="stylesheet" href="../../static/styles/partials/nav.css" />
    <title>Document</title>
  </head>
  <body>
    <header>
      <div class="container navbar-container">
        <a href="/" class="logo-wrapper">
          <img src="../../static/assets/logo.png" alt="logo" class="logo" />
          <h1 class="nav-title">Taskify</h1>
        </a>

        <nav>
          <ul class="nav-items">
            <li><a href="#"><%= t('nav_features') %></a></li>
            <li><a href="#"><%= t('nav_templates') %></a></li>
            <li><a href="#"><%= t('nav_for_teams') %></a></li>
            <li><a href="#"><%= t('nav_resources') %></a></li>
            <li><a href="#"><%= t('nav_pricing') %></a></li>
          </ul>
        </nav>
        <div class="nav-buttons">
          <a href="/signup" class="btn1 nav-btn"><%= t('nav_signup') %></a>
          <a href="/dashboard" class="btn2 nav-btn"><%= t('nav_login') %></a>
        </div>
        <div class="language-switch">
          <button onclick="switchLanguage('en')">English</button>
          <button onclick="switchLanguage('zh')">中文</button>
        </div>
      </div>
    </header>
    <script>
    function switchLanguage(lang) {
        document.cookie = "lang=" + lang + "; path=/";
        window.location.reload();
    }
    </script>
  </body>
</html>