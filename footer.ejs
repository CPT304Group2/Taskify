<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="../../static/styles/main.css">
    <link rel="stylesheet" href="../../static/styles/partials/footer.css" />

    
    <title>Document</title>
  </head>
  <body>
    <footer class="section footer-section">
        
        <div class="container footer-container">
          <div class="footer-top">
           
        <div class="footer-left-column">
                 <p><%= t.footer_desc %></p>
                <ul aria-label="Social links">
                    
                    <li><a aria-label="facebook" href="#"><img src="../../static/assets/facebook.png" class="footer-image" alt="Facebook"></a></li>
                    <li><a aria-label="youtube" href="#"><img src="../../static/assets/youtube.png" class="footer-image" alt="Youtube"></a></li>
                    <li><a aria-label="twitter" href="#"><img src="../../static/assets/twitter.png" class="footer-image" alt="Twitter"></a></li>
                    <li><a aria-label="instagram" href="#"><img src="../../static/assets/instagram.png" class="footer-image" alt="Instagram"></a></li>
                </ul>
         </div>
            
         <div class="footer-right-column">
            <div class="footer-column">
                <h3 class="footer-heading"><%= t.footer_features %></h3>
                    <ul aria-label="Footer" role="list">
                        
                        <li><a href=""><%= t.footer_how_it_works %></a></li>
                        <li><a href=""><%= t.footer_for_teams %></a></li>
                        <li><a href=""><%= t.footer_pricing %></a></li>
                        <li><a href=""><%= t.footer_templates %></a></li>

                    </ul>
            </div>
         <div class="footer-column">
            <h3 class="footer-heading"><%= t.footer_resources %></h3>
             <ul>
                
                <li><a href=""><%= t.footer_download_apps %></a></li>
                <li><a href=""><%= t.footer_help_center %></a></li>
                <li><a href=""><%= t.footer_productivity %></a></li>
                <li><a href=""><%= t.footer_refer %></a></li>
                <li><a href=""><%= t.footer_integrations %></a></li>
                <li><a href=""><%= t.footer_partners %></a></li>
                <li><a href=""><%= t.footer_developer %></a></li>
                <li><a href=""><%= t.footer_status %></a></li>

             </ul>
         </div>
         <div class="footer-column">
            <h3 class="footer-heading"><%= t.footer_company %></h3>
            <ul>
                
                <li><a href=""><%= t.footer_about %></a></li>
                <li><a href=""><%= t.footer_hiring %></a></li>
                <li><a href=""><%= t.footer_blog %></a></li>
                <li><a href=""><%= t.footer_press %></a></li>
                <li><a href=""><%= t.footer_twist %></a></li>
                

             </ul>
         </div>
         </div>
        </div>
         <div class="footer-copyright">
          <ul>
            <li style="border-right: 2px solid black"><a href=""><%= t.footer_security %></a></li>
            <li style="border-right: 2px solid black"><a href="/privacy"><%= t.footer_privacy %></a></li>
            <li><a href=""><%= t.footer_terms %></a></li>
          </ul>  
         <p class="footer-taskify-inc"><%= t.footer_copyright %></p>


        </div>
         </div>
            
        
    </footer>
    <% if (!cookiesAccepted) { %>
<div id="cookie-banner" style="position: fixed; bottom: 0; left: 0; right: 0; background: #2c3e50; color: white; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; z-index: 9999; font-family: sans-serif;">
    <p style="margin: 0; font-size: 14px;"><%= t.cookie_message %> <a href="/privacy" style="color: #ffd700; text-decoration: underline;"><%= t.cookie_privacy %></a>.</p>
    <button id="accept-cookies" style="background: #ffd700; color: #2c3e50; border: none; padding: 8px 20px; border-radius: 4px; cursor: pointer; font-weight: bold;"><%= t.cookie_accept %></button>
</div>

<script>
    document.getElementById('accept-cookies').onclick = function() {
        document.cookie = "cookies_accepted=true; path=/; max-age=" + (60*60*24*365);
        document.getElementById('cookie-banner').style.display = 'none';
    };
</script>
<% } %>
    
  </body>
 
</html>
